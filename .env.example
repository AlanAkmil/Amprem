# URL API layanan aktivasi (dipakai di server saja, BUKAN secret).
# Jika kosong, nilai default di src/config/api.ts dipakai.
API_BASE_URL=https://am-premium-nimzz.vercel.app

# URL publik website ini (untuk canonical, OpenGraph, sitemap).
NEXT_PUBLIC_SITE_URL=https://alight-motion-premium-hidaka401.vercel.app

# Bot Telegram untuk menerima bukti transfer donasi (halaman /donasi).
# Ini SECRET — hanya diset di dashboard Vercel (Environment Variables), JANGAN commit nilai aslinya.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
